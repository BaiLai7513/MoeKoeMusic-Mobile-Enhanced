+      var songs = (res && res.data && res.data.songs) || [];
+      likedSet = new Set(songs.map(function(s){ return s.hash; }).filter(Boolean));
+      loading = false;
+      return likedSet;
+    }).catch(function(){ loading = false; likedSet = likedSet || new Set(); return likedSet; });
+  }
+
+  function findFileId(hash){
+    var like = localStorage.getItem('like');
+    if(!like) return Promise.resolve('');
+    return api('/playlist/track/all?listid=' + encodeURIComponent(like) + '&pagesize=500').then(function(res){
+      var songs = (res && res.data && res.data.songs) || [];
+      for(var i = 0; i < songs.length; i++){
+        if(String(songs[i].hash) === String(hash)) return songs[i].fileid || songs[i].file_id || '';
+      }
+      return '';
+    }).catch(function(){ return ''; });
+  }
+
+  function toggleLike(like){
+    var song = currentSong();
+    if(!song || !song.hash || song.isLocal || song.isCloud){
+      window.$modal && window.$modal.alert('当前没有可收藏的在线歌曲');
+      return Promise.resolve(false);
+    }
+    return loadLiked(false).then(function(set){
+      set = set || likedSet || new Set();
+      var liked = set.has(song.hash);
+      if(liked){
+        return findFileId(song.hash).then(function(fileid){
+          if(!fileid){
+            set.delete(song.hash);
+            updateLikeIcons(false);
+            return false;
+          }
+          return api('/playlist/tracks/del?listid=' + encodeURIComponent(like) + '&fileids=' + encodeURIComponent(fileid)).then(function(res){
+            if(okRes(res)){
+              set.delete(song.hash);
+              updateLikeIcons(false);
+              window.$message && window.$message.success('已取消喜欢');
+              return false;
+            }
+            window.$message && window.$message.error((res && (res.error_msg || res.error || res.msg)) || '取消喜欢失败');
+            return true;
+          });
+        });
+      }
+      var data = encodeURIComponent(String(song.name || '').replace(/,/g, '')) + '|' + encodeURIComponent(song.hash);
+      return api('/playlist/tracks/add?listid=' + encodeURIComponent(like) + '&data=' + data).then(function(res){
+        if(okRes(res)){
+          set.add(song.hash);
+          updateLikeIcons(true);
+          window.$message && window.$message.success('已添加到我喜欢的音乐');
+          return true;
+        }
+        window.$message && window.$message.error((res && (res.error_msg || res.error || res.msg)) || '收藏失败');
+        return false;
+      });
+    }).catch(function(){
+      window.$message && window.$message.error('操作失败，请稍后重试');
+      return false;
+    });
+  }
+
+  window.__moeToggleLike = toggleLike;
+  window.__moeGetAuthHeader = getAuthHeader;
+  window.__moeRefreshLiked = function(){ return loadLiked(true); };
+
+  setInterval(function(){
+    var like = localStorage.getItem('like');
+    if(!like){ updateLikeIcons(false); return; }
+    loadLiked(false).then(function(set){
+      var song = currentSong();
+      updateLikeIcons(!!(song && song.hash && set && set.has(song.hash)));
+    });
+  }, 1200);
+
+  loadLiked(false).then(function(){ var song = currentSong(); updateLikeIcons(!!(song && song.hash && likedSet && likedSet.has(song.hash))); });
+})();
