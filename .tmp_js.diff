+            if(res && (res.status === 1 || res.error_msg === '' || res.data)){
+              try{ localStorage.setItem('t', Date.now()); }catch(e){}
+              window.$message && window.$message.success('歌单创建成功');
+              setTimeout(function(){ location.reload(); }, 600);
