+      var btn = nodes[i];
+      btn.classList.toggle('moe-liked', !!liked);
+      var icon = btn.querySelector('i');
+      if(icon) icon.className = liked ? 'fas fa-heart' : 'far fa-heart';
+    }
+  }
+
+  function loadLiked(force){
+    var like = localStorage.getItem('like');
+    if(!like){ likedSet = new Set(); updateLikeIcons(false); return Promise.resolve(likedSet); }
